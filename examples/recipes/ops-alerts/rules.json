{
  "askFirst": [
    "apagar dados",
    "derrubar serviço",
    "gastar dinheiro",
    "enviar mensagens a terceiros",
    "mudar a direção do produto",
    "criar ou rotacionar chaves",
    "alterar permissões",
    "mexer em produção"
  ],
  "sources": {
    "shop": { "name": "shop" },
    "shop-fix": { "name": "correção do shop" }
  },
  "agents": {
    "agent": { "name": "Agent", "worker": "mac-mini", "use": "codex", "access": "read" },
    "restart": {
      "name": "Script de reinicialização",
      "worker": "mac-mini",
      "use": "command",
      "command": ["{cwd}/restart.sh"]
    }
  },
  "rules": [
    {
      "name": "Investigar erros de produção",
      "when": { "source": "shop", "types": ["alert.*"] },
      "to": "agent",
      "cwd": "~/code/shop",
      "skill": "ops-alerts",
      "parallel": 3,
      "emits": { "source": "shop-fix", "types": ["restart"] }
    },
    {
      "name": "Reiniciar",
      "when": { "source": "shop-fix", "types": ["restart"] },
      "to": "restart",
      "cwd": "~/code/shop",
      "tell": "always"
    }
  ]
}
