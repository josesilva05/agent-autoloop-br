{
  "timezone": "Asia/Shanghai",
  "askFirst": [
    "apagar dados",
    "derrubar serviço",
    "gastar dinheiro",
    "enviar mensagens a terceiros",
    "mudar a direção do produto",
    "criar ou rotacionar chaves",
    "alterar permissões"
  ],
  "sources": {
    "inbox-triage": {
      "name": "Caixa de entrada"
    }
  },
  "agents": {
    "inbox-collector": {
      "name": "Leitura da caixa de entrada",
      "worker": "my-computer",
      "use": "command",
      "command": ["node", "{cwd}/collect.ts", "{cwd}/sources.json"]
    },
    "inbox-agent": {
      "name": "Agent de triagem da caixa de entrada",
      "worker": "my-computer",
      "use": "codex",
      "access": "edit"
    }
  },
  "rules": [
    {
      "name": "Ler a caixa de entrada",
      "when": {
        "cron": "0 8 * * *"
      },
      "to": "inbox-collector",
      "cwd": "~/.agent-autoloop/work/inbox-triage",
      "group": "inbox-triage",
      "tell": "needed",
      "emits": {
        "source": "inbox-triage",
        "types": ["inbox.ready"]
      }
    },
    {
      "name": "Organizar a lista da caixa de entrada",
      "when": {
        "source": "inbox-triage",
        "types": ["inbox.ready"]
      },
      "to": "inbox-agent",
      "cwd": "~/.agent-autoloop/work/inbox-triage",
      "group": "inbox-triage",
      "skill": "inbox-triage",
      "tell": "needed"
    }
  ],
  "channels": {
    "feishu": {
      "name": "Feishu",
      "answerers": ["ou_REPLACE_ME"]
    }
  }
}
