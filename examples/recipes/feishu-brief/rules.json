{
  "timezone": "Asia/Shanghai",
  "askFirst": [
    "apagar dados",
    "derrubar serviço",
    "gastar dinheiro",
    "enviar mensagens a terceiros",
    "mudar a direção do produto",
    "criar ou rotacionar chaves",
    "alterar permissões"
  ],
  "sources": {
    "feishu-brief": {
      "name": "Dados de resumo do Feishu"
    }
  },
  "agents": {
    "brief-collector": {
      "name": "Leitura dos dados do Feishu",
      "worker": "my-computer",
      "use": "command",
      "command": ["node", "{cwd}/collect.ts", "{cwd}/sources.json"]
    },
    "brief-agent": {
      "name": "Agent de resumo semanal",
      "worker": "my-computer",
      "use": "codex",
      "access": "edit"
    }
  },
  "rules": [
    {
      "name": "Ler os dados do relatório semanal do Feishu",
      "when": {
        "cron": "0 18 * * 0"
      },
      "to": "brief-collector",
      "cwd": "~/.agent-autoloop/work/feishu-brief",
      "group": "feishu-brief",
      "tell": "needed",
      "emits": {
        "source": "feishu-brief",
        "types": ["brief.ready"]
      }
    },
    {
      "name": "Organizar o relatório semanal e o resumo de negócio do Feishu",
      "when": {
        "source": "feishu-brief",
        "types": ["brief.ready"]
      },
      "to": "brief-agent",
      "cwd": "~/.agent-autoloop/work/feishu-brief",
      "group": "feishu-brief",
      "skill": "feishu-brief",
      "tell": "needed"
    }
  ],
  "channels": {
    "feishu": {
      "name": "Feishu",
      "answerers": ["ou_REPLACE_ME"]
    }
  }
}
