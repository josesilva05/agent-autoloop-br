{
  "timezone": "Asia/Shanghai",
  "askFirst": [
    "apagar dados",
    "derrubar serviço",
    "gastar dinheiro",
    "enviar mensagens a terceiros",
    "mudar a direção do produto",
    "criar ou rotacionar chaves",
    "alterar permissões"
  ],
  "sources": { "browser-tasks": { "name": "Pedidos de verificação de página" } },
  "agents": {
    "browser-owner": {
      "name": "Tarefa principal do Claude",
      "worker": "my-computer",
      "use": "claude",
      "access": "edit"
    }
  },
  "channels": { "feishu": { "name": "Feishu", "answerers": ["ou_REPLACE_ME"] } },
  "rules": [
    {
      "name": "Delegar ao Codex a verificação da página",
      "when": { "source": "browser-tasks", "types": ["browser.verify"] },
      "to": "browser-owner",
      "cwd": "~/.agent-autoloop/work/browser-handoff",
      "skill": "claude-browser-handoff",
      "tell": "needed"
    }
  ]
}
