{
  "timezone": "Asia/Shanghai",
  "askFirst": [
    "apagar dados",
    "derrubar serviço",
    "gastar dinheiro",
    "enviar mensagens a terceiros",
    "mudar a direção do produto",
    "criar ou rotacionar chaves",
    "alterar permissões"
  ],
  "sources": {
    "feedback": {
      "name": "Feedback de usuários"
    }
  },
  "agents": {
    "feedback-agent": {
      "name": "Agent de manutenção de feedback",
      "worker": "my-computer",
      "use": "codex",
      "access": "edit"
    }
  },
  "rules": [
    {
      "name": "Tratar feedback de usuários",
      "when": {
        "source": "feedback",
        "types": ["feedback.new", "feedback.followup"]
      },
      "to": "feedback-agent",
      "cwd": "~/code/my-project",
      "skill": "handle-feedback",
      "parallel": 3,
      "tell": "needed"
    }
  ],
  "channels": {
    "feishu": {
      "name": "Feishu",
      "answerers": ["ou_REPLACE_ME"]
    }
  }
}
