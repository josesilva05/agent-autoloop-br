{
  "timezone": "Asia/Shanghai",
  "askFirst": [
    "apagar dados",
    "derrubar serviço",
    "gastar dinheiro",
    "enviar mensagens a terceiros",
    "mudar a direção do produto",
    "criar ou rotacionar chaves",
    "alterar permissões"
  ],
  "sources": {
    "website-watch": {
      "name": "Inspeção de sites"
    }
  },
  "agents": {
    "website-check": {
      "name": "Script de verificação do site",
      "worker": "my-computer",
      "use": "command",
      "command": ["node", "{cwd}/check.ts", "{cwd}/site.json"]
    },
    "website-agent": {
      "name": "Agent de manutenção do site",
      "worker": "my-computer",
      "use": "codex",
      "access": "read"
    }
  },
  "rules": [
    {
      "name": "Verificar o site",
      "when": {
        "cron": "*/5 * * * *"
      },
      "to": "website-check",
      "cwd": "~/.agent-autoloop/work/website-watch",
      "group": "website-probe",
      "tell": "needed",
      "emits": {
        "source": "website-watch",
        "types": ["site.down", "site.recovered"]
      }
    },
    {
      "name": "Investigar anomalia do site",
      "when": {
        "source": "website-watch",
        "types": ["site.down", "site.recovered"]
      },
      "to": "website-agent",
      "cwd": "~/code/my-project",
      "skill": "website-watch",
      "tell": "needed"
    }
  ],
  "channels": {
    "feishu": {
      "name": "Feishu",
      "answerers": ["ou_REPLACE_ME"]
    }
  }
}
