{
  "timezone": "Asia/Shanghai",
  "sources": { "app": { "name": "aplicativo" }, "ops": { "name": "operações" }, "hooks": { "name": "externo", "adapter": "echo" } },
  "agents": {
    "a1": { "name": "alfa", "worker": "w1", "use": "claude", "model": "m1", "effort": "high" },
    "a2": { "name": "beta", "worker": "w2", "use": "codex", "access": "full", "tier": "priority" },
    "a3": { "name": "gama", "worker": "w1", "use": "command", "command": ["echo", "{prompt}"] }
  },
  "channels": { "chat": { "name": "chat", "answerers": ["me"] }, "plain": { "name": "texto", "links": true } },
  "rules": [
    {
      "name": "opiniões",
      "when": { "source": "app", "types": ["feedback.*"] },
      "to": "a1",
      "cwd": "~/x",
      "skill": "s",
      "prompt": "Siga o manual.",
      "title": "note-{id}",
      "group": "notes",
      "parallel": 3
    },
    {
      "name": "alerta",
      "when": { "source": "ops", "types": ["alert.raised"] },
      "to": "a2",
      "cwd": "~/y",
      "prompt": "Trate o alerta.",
      "group": "ops",
      "tell": "always"
    },
    {
      "name": "alerta também registra",
      "when": { "source": "ops", "types": ["alert.raised"] },
      "to": "a1",
      "cwd": "~/x",
      "prompt": "Registre.",
      "tell": "never"
    },
    {
      "name": "briefing matinal",
      "when": { "cron": "0 9 * * *" },
      "to": "a1",
      "cwd": "~/x",
      "prompt": "Escreva o briefing."
    },
    {
      "name": "inspeção",
      "when": { "cron": "*/5 * * * *" },
      "to": "a3",
      "cwd": "~/y",
      "emits": { "source": "app", "types": ["feedback.new"] }
    }
  ],
  "elsewhere": [
    {
      "name": "limpeza semanal",
      "source": "app",
      "to": "a1",
      "cron": "0 6 * * 0",
      "where": "tarefa agendada no aplicativo"
    }
  ]
}
